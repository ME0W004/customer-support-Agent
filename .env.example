# ========================================================
# AI Customer Support Automation - Environment Configuration
# ========================================================

# 1. Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase PostgreSQL Connection String (from Supabase Project Settings > Database)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# 3. Google OAuth Credentials (for Gmail API access)
# You can get these from Google Cloud Console > Credentials > OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret_here

# The refresh token will be generated automatically by running: uv run python -m scripts.get_refresh_token
GMAIL_REFRESH_TOKEN=

# 4. Support Email Address (the demo/test Gmail account you are monitoring)
SUPPORT_EMAIL=your_test_support_account@gmail.com

# 5. Polling Interval (in seconds)
POLL_INTERVAL_SECONDS=30
